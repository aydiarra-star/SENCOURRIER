# ═══════════════════════════════════════════════════════════════════════════
# SENCOURRIER — Variables d'environnement
# Le média numérique de référence du Sénégal
#
# Copier ce fichier vers `.env` puis renseigner les valeurs réelles.
#   cp .env.example .env
#
# Aucune valeur de ce fichier ne doit être commitée : `.env` est ignoré par git.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# APPLICATION
# ───────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=SENCOURRIER
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
LOG_LEVEL=debug

# Domaine public canonique (utilisé pour les permaliens, le sitemap et les OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ───────────────────────────────────────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL
# ───────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sencourrier:sencourrier@localhost:5432/sencourrier?schema=public
POSTGRES_USER=sencourrier
POSTGRES_PASSWORD=sencourrier
POSTGRES_DB=sencourrier
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pool de connexions Prisma
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT_MS=10000

# ───────────────────────────────────────────────────────────────────────────
# CACHE — Redis
# ───────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ───────────────────────────────────────────────────────────────────────────
# RECHERCHE — Elasticsearch
# ───────────────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PREFIX=sencourrier
ELASTICSEARCH_ENABLED=false

# ───────────────────────────────────────────────────────────────────────────
# AUTHENTIFICATION
# ───────────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-48

JWT_ACCESS_SECRET=change-me-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=change-me-with-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=sencourrier.sn
JWT_AUDIENCE=sencourrier-web

# OAuth Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Double authentification (TOTP)
TWO_FACTOR_ISSUER=SENCOURRIER
TWO_FACTOR_ENCRYPTION_KEY=change-me-with-openssl-rand-base64-32

# ───────────────────────────────────────────────────────────────────────────
# STOCKAGE MÉDIAS — Azure Blob Storage
# ───────────────────────────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_MEDIA=media
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_PUBLIC_BASE_URL=
AZURE_STORAGE_CDN_URL=

# ───────────────────────────────────────────────────────────────────────────
# EMAILS — Resend
# ───────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM_EMAIL=noreply@sencourrier.sn
MAIL_FROM_NAME=SENCOURRIER
MAIL_REPLY_TO=redaction@sencourrier.sn
MAIL_NEWSLETTER_AUDIENCE_ID=

# ───────────────────────────────────────────────────────────────────────────
# IA — Azure OpenAI (assistant RAG)
# ───────────────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21
AI_ASSISTANT_ENABLED=false
AI_EMBEDDING_DIMENSIONS=3072
AI_RAG_TOP_K=8

# ───────────────────────────────────────────────────────────────────────────
# PAIEMENTS
# ───────────────────────────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=

# Wave Sénégal — https://wave.com/fr/business
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_MERCHANT_ID=

# Orange Money Sénégal
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# Free Money Sénégal
FREE_MONEY_API_KEY=
FREE_MONEY_MERCHANT_ID=
FREE_MONEY_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────────────
# ANALYTICS ET PUBLICITÉ
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_AD_MANAGER_NETWORK_CODE=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ENABLE_ADS=true

# ───────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS PUSH
# Générer les clés avec : npx web-push generate-vapid-keys
# ───────────────────────────────────────────────────────────────────────────
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:redaction@sencourrier.sn

# ───────────────────────────────────────────────────────────────────────────
# SÉCURITÉ
# ───────────────────────────────────────────────────────────────────────────
# Limitation de débit : requêtes par fenêtre de 60 secondes
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

CORS_ORIGINS=http://localhost:3000,https://www.sencourrier.sn
CSRF_SECRET=change-me-with-openssl-rand-base64-32
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Hachage des adresses IP dans les journaux d'audit (conformité RGPD)
IP_HASH_SALT=change-me-with-openssl-rand-base64-32

# ───────────────────────────────────────────────────────────────────────────
# OBSERVABILITÉ
# ───────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
APPLICATIONINSIGHTS_CONNECTION_STRING=
HEALTH_CHECK_TOKEN=

# ───────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_TV_LIVE=true
NEXT_PUBLIC_ENABLE_PODCASTS=true
NEXT_PUBLIC_ENABLE_COMMENTS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ───────────────────────────────────────────────────────────────────────────
# SEED (jeu de démonstration)
# ───────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sencourrier.sn
SEED_ADMIN_PASSWORD=SenCourrier!2024
SEED_DEMO_DATA=true
