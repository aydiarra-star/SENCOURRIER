  "devDependencies": {
    "@nestjs/cli": "11.0.12",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.7",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsdom": "21.1.7",
    "@types/multer": "^1.4.12",
    "@types/node": "22.18.6",
    "@types/passport-google-oauth20": "2.0.16",
    "@types/passport-jwt": "4.0.1",
    "@types/sanitize-html": "2.16.0",
