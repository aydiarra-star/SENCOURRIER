{
  "name": "@sencourrier/api",
  "version": "1.0.0",
  "private": true,
  "description": "SENCOURRIER REST API — NestJS backend",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@azure/storage-blob": "12.28.0",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@sencourrier/config": "*",
    "@sencourrier/database": "*",
    "@sencourrier/types": "*",
    "bcryptjs": "3.0.3",
    "cache-manager": "7.2.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dompurify": "3.2.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.1",
    "jsdom": "26.1.0",
    "nanoid": "5.1.6",
    "nest-winston": "1.10.2",
    "nestjs-pino": "4.4.1",
    "otplib": "12.0.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "resend": "6.1.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",
    "sharp": "0.34.4",
    "slugify": "1.6.6",
    "stripe": "19.1.0",
    "web-push": "3.6.7",
    "winston": "3.18.3",
    "zod": "4.6.5"
